<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SI KOMPAK - SD Negeri Pilang 1</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    
    <!-- Canvas Confetti for Reward Animations -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            red: '#E53935',
                            darkred: '#C62828',
                            lightred: '#FFEBEE',
                            accent: '#FF5252',
                            gold: '#FFC107'
                        }
                    },
                    fontFamily: {
                        sans: ['Poppins', 'sans-serif'],
                        fredoka: ['Fredoka', 'cursive']
                    }
                }
            }
        }
    </script>
    <style>
        /* Smooth Morphing & Transition Keyframes */
        .morph-element {
            transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
        }
        
        .fade-in-scale {
            animation: fadeInScale 0.35s ease-out forwards;
        }

        @keyframes fadeInScale {
            0% {
                opacity: 0;
                transform: scale(0.94) translateY(10px);
            }
            100% {
                opacity: 1;
                transform: scale(1) translateY(0);
            }
        }

        .slide-up {
            animation: slideUp 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        @keyframes slideUp {
            0% { opacity: 0; transform: translateY(20px); }
            100% { opacity: 1; transform: translateY(0); }
        }

        /* Custom Scrollbar for Reading Mode */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #F1F1F1;
            border-radius: 8px;
        }
        ::-webkit-scrollbar-thumb {
            background: #E53935;
            border-radius: 8px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #C62828;
        }

        /* Gradient Glass Effects */
        .glass-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(229, 57, 53, 0.15);
        }

        .floating-bubble {
            animation: float 6s ease-in-out infinite;
        }

        @keyframes float {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-12px) rotate(2deg); }
        }
    </style>
</head>
<body class="bg-slate-100 text-slate-800 font-sans min-h-screen flex flex-col antialiased selection:bg-brand-red selection:text-white">

    <!-- Dynamic Alert/Toast Container -->
    <div id="toast-container" class="fixed top-5 right-5 z-50 flex flex-col gap-3 pointer-events-none"></div>

    <!-- LOGIN PAGE VIEW -->
    <div id="login-page" class="min-h-screen bg-gradient-to-br from-red-600 via-brand-red to-rose-700 flex flex-col justify-between p-4 sm:p-6 md:p-10 relative overflow-hidden">
        
        <!-- Background Animated Bubbles -->
        <div class="absolute -top-20 -left-20 w-80 h-80 bg-white/10 rounded-full blur-3xl pointer-events-none floating-bubble"></div>
        <div class="absolute -bottom-20 -right-20 w-96 h-96 bg-brand-gold/20 rounded-full blur-3xl pointer-events-none floating-bubble" style="animation-delay: -3s;"></div>

        <!-- Top Branding Header -->
        <div class="text-center text-white mb-6 z-10 fade-in-scale">
            <div class="inline-flex items-center justify-center p-3 bg-white/10 backdrop-blur-md rounded-2xl mb-3 border border-white/20 shadow-lg">
                <i data-lucide="book-open-check" class="w-10 h-10 text-yellow-300 mr-3"></i>
                <h1 class="text-3xl sm:text-4xl md:text-5xl font-fredoka font-bold tracking-wide text-white drop-shadow">
                    APLIKASI SI KOMPAK
                </h1>
            </div>
            <p class="text-rose-100 text-sm sm:text-base md:text-lg font-medium tracking-wide">
                (Sistem Komik Pendidikan Karakter) • <span class="bg-yellow-400 text-red-900 font-bold px-3 py-1 rounded-full shadow-inner">SD Negeri Pilang 1</span>
            </p>
        </div>

        <!-- 2 Column Login Box -->
        <div class="max-w-4xl w-full mx-auto grid grid-cols-1 md:grid-cols-2 gap-6 my-auto z-10 fade-in-scale">
            
            <!-- COLUMN 1: GURU / ADMIN -->
            <div class="glass-card rounded-3xl p-6 sm:p-8 shadow-2xl relative overflow-hidden border-2 border-brand-red/20 hover:border-brand-red/50 transition-all group">
                <div class="absolute top-0 right-0 bg-brand-red text-white text-xs font-bold px-4 py-1.5 rounded-bl-2xl uppercase tracking-wider flex items-center gap-1">
                    <i data-lucide="shield-alert" class="w-3.5 h-3.5"></i> Akses Editor
                </div>
                
                <div class="flex items-center gap-3 mb-4">
                    <div class="p-3 bg-red-100 text-brand-red rounded-2xl group-hover:scale-110 transition-transform">
                        <i data-lucide="user-cog" class="w-8 h-8"></i>
                    </div>
                    <div>
                        <h2 class="text-xl font-bold font-fredoka text-slate-900">Portal Guru / Admin</h2>
                        <p class="text-xs text-slate-500">Kelola & Unggah Komik Karakter</p>
                    </div>
                </div>

                <form id="guru-login-form" onsubmit="handleGuruLogin(event)" class="space-y-4">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Nama Pengguna / Sekolah</label>
                        <div class="relative">
                            <i data-lucide="school" class="w-5 h-5 absolute left-3.5 top-3 text-slate-400"></i>
                            <input type="text" value="SDN PILANG 1" readonly class="w-full bg-slate-100 border border-slate-200 rounded-xl py-2.5 pl-11 pr-4 text-sm font-semibold text-slate-700 focus:outline-none">
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Password Sandi Guru</label>
                        <div class="relative">
                            <i data-lucide="key-round" class="w-5 h-5 absolute left-3.5 top-3 text-slate-400"></i>
                            <input type="password" id="guru-password" placeholder="Masukkan password (Pilang1)" required class="w-full bg-white border border-slate-300 rounded-xl py-2.5 pl-11 pr-11 text-sm text-slate-800 focus:ring-2 focus:ring-brand-red focus:border-brand-red outline-none transition">
                            <button type="button" onclick="togglePasswordVisibility('guru-password', 'eye-icon')" class="absolute right-3.5 top-2.5 text-slate-400 hover:text-slate-600">
                                <i id="eye-icon" data-lucide="eye" class="w-5 h-5"></i>
                            </button>
                        </div>
                        <p class="text-[11px] text-slate-400 mt-1 italic">*Gunakan kata sandi "Pilang1" untuk login</p>
                    </div>

                    <button type="submit" class="w-full bg-gradient-to-r from-brand-red to-rose-600 hover:from-brand-darkred hover:to-rose-700 text-white font-semibold py-3 rounded-xl shadow-lg shadow-red-500/30 hover:shadow-red-500/50 transition-all flex items-center justify-center gap-2 group-hover:translate-y-[-1px]">
                        <span>Masuk Mode Guru</span>
                        <i data-lucide="arrow-right" class="w-4 h-4"></i>
                    </button>
                </form>
            </div>

            <!-- COLUMN 2: SISWA & ORANG TUA -->
            <div class="glass-card rounded-3xl p-6 sm:p-8 shadow-2xl relative overflow-hidden border-2 border-emerald-500/20 hover:border-emerald-500/50 transition-all group">
                <div class="absolute top-0 right-0 bg-emerald-600 text-white text-xs font-bold px-4 py-1.5 rounded-bl-2xl uppercase tracking-wider flex items-center gap-1">
                    <i data-lucide="sparkles" class="w-3.5 h-3.5"></i> Akses Publik
                </div>

                <div class="flex items-center gap-3 mb-4">
                    <div class="p-3 bg-emerald-100 text-emerald-600 rounded-2xl group-hover:scale-110 transition-transform">
                        <i data-lucide="users" class="w-8 h-8"></i>
                    </div>
                    <div>
                        <h2 class="text-xl font-bold font-fredoka text-slate-900">Siswa & Orang Tua</h2>
                        <p class="text-xs text-slate-500">Baca Komik Digital & Panduan Karakter</p>
                    </div>
                </div>

                <div class="space-y-4 pt-2">
                    <p class="text-xs text-slate-600 leading-relaxed">
                        Akses cepat langsung tanpa password untuk seluruh Murid dan Orang Tua/Wali murid SD Negeri Pilang 1. Pilih tujuan akses Anda di bawah:
                    </p>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
                        <button onclick="loginAsRole('SISWA')" class="bg-gradient-to-br from-amber-400 to-orange-500 hover:from-amber-500 hover:to-orange-600 text-slate-900 font-bold p-3.5 rounded-2xl shadow-md hover:shadow-lg transition flex flex-col items-center justify-center text-center gap-1 group/btn">
                            <i data-lucide="smile" class="w-7 h-7 text-white group-hover/btn:scale-110 transition-transform"></i>
                            <span class="text-sm text-white">Portal SISWA</span>
                            <span class="text-[10px] text-amber-100 font-normal">Baca Komik Seru</span>
                        </button>

                        <button onclick="loginAsRole('ORTU')" class="bg-gradient-to-br from-blue-500 to-indigo-600 hover:from-blue-600 hover:to-indigo-700 text-white font-bold p-3.5 rounded-2xl shadow-md hover:shadow-lg transition flex flex-col items-center justify-center text-center gap-1 group/btn">
                            <i data-lucide="heart-handshake" class="w-7 h-7 text-blue-200 group-hover/btn:scale-110 transition-transform"></i>
                            <span class="text-sm">Portal ORANG TUA</span>
                            <span class="text-[10px] text-blue-100 font-normal">Panduan & Refleksi</span>
                        </button>
                    </div>
                </div>
            </div>

        </div>

        <!-- Footer Footer -->
        <div class="text-center text-white/90 text-xs sm:text-sm font-medium z-10 pt-4 border-t border-white/10">
            Aplikasi ini dikembangkan oleh <span class="font-bold underline decoration-yellow-400 decoration-2">SDN PILANG 1</span> © 2026
        </div>
    </div>

    <!-- MAIN DASHBOARD VIEW (Hidden by default) -->
    <div id="main-app" class="hidden min-h-screen flex-col bg-slate-50">
        
        <!-- Top Navbar Header -->
        <header class="bg-gradient-to-r from-brand-red via-red-600 to-rose-700 text-white sticky top-0 z-30 shadow-md">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
                
                <!-- Logo & Brand Info -->
                <div class="flex items-center space-x-3">
                    <div class="p-2 bg-white/10 backdrop-blur rounded-xl border border-white/20">
                        <i data-lucide="book-open text-yellow-300" class="w-7 h-7 sm:w-8 sm:h-8"></i>
                    </div>
                    <div>
                        <div class="flex items-center gap-2">
                            <h1 class="font-fredoka text-xl sm:text-2xl font-bold tracking-wide">SI KOMPAK</h1>
                            <span id="role-badge" class="text-[10px] font-bold px-2.5 py-0.5 rounded-full bg-yellow-400 text-red-950 uppercase tracking-wider">ROLE</span>
                        </div>
                        <p class="text-xs text-rose-100 hidden sm:block">SD Negeri Pilang 1 • Portal Komik Digital Karakter</p>
                    </div>
                </div>

                <!-- Navigation Tabs (Desktop) -->
                <nav class="hidden md:flex items-center bg-black/15 p-1.5 rounded-2xl backdrop-blur-sm border border-white/10" id="desktop-tab-nav">
                    <!-- Dynamic Tabs Inserted Here -->
                </nav>

                <!-- User Session & Logout -->
                <div class="flex items-center space-x-3">
                    <div class="text-right hidden sm:block">
                        <p id="user-display-name" class="text-xs font-semibold text-white">Siswa SDN Pilang 1</p>
                        <p class="text-[10px] text-rose-200">Aktif Bersekolah</p>
                    </div>
                    <button onclick="logout()" title="Keluar / Ganti Akses" class="p-2.5 bg-white/10 hover:bg-white/20 text-white rounded-xl transition border border-white/20 flex items-center gap-1.5 text-xs font-semibold">
                        <i data-lucide="log-out" class="w-4 h-4"></i>
                        <span class="hidden sm:inline">Ganti Role</span>
                    </button>
                </div>

            </div>

            <!-- Mobile Navigation Bar Below Header -->
            <div class="md:hidden bg-red-800/60 backdrop-blur px-4 py-2 flex items-center justify-around border-t border-white/10 overflow-x-auto" id="mobile-tab-nav">
                <!-- Dynamic Mobile Tabs -->
            </div>
        </header>

        <!-- Dynamic Main Content Area -->
        <main class="flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6 lg:p-8">
            
            <!-- TAB CONTENT: SISWA PORTAL -->
            <section id="tab-siswa" class="tab-content morph-element hidden">
                
                <!-- Hero Header Banner -->
                <div class="bg-gradient-to-r from-amber-400 via-orange-400 to-rose-500 rounded-3xl p-6 sm:p-8 text-white shadow-xl mb-8 relative overflow-hidden">
                    <div class="relative z-10 max-w-2xl">
                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/20 backdrop-blur-md text-xs font-bold text-white mb-3">
                            <i data-lucide="sparkles" class="w-3.5 h-3.5 text-yellow-200"></i> Selamat Datang, Sahabat Pilang!
                        </span>
                        <h2 class="text-2xl sm:text-4xl font-fredoka font-bold text-slate-900 mb-2">Yuk, Baca Komik Karakter Pancasila Hari Ini!</h2>
                        <p class="text-slate-800 text-sm sm:text-base font-medium">Pilih komik favoritmu berdasarkan kelas dan petualangan seru yang kamu sukai!</p>
                    </div>
                    <i data-lucide="smile" class="absolute -bottom-6 -right-6 w-48 h-48 text-white/20 pointer-events-none"></i>
                </div>

                <!-- Phase Filter Tabs -->
                <div class="flex items-center justify-between flex-wrap gap-4 mb-6">
                    <div>
                        <h3 class="text-lg font-bold font-fredoka text-slate-800 flex items-center gap-2">
                            <i data-lucide="filter" class="w-5 h-5 text-brand-red"></i> Filter Tingkat Kelas
                        </h3>
                        <p class="text-xs text-slate-500">Pilih Fase belajar untuk menampilkan komik yang cocok</p>
                    </div>

                    <!-- Filter Buttons Group -->
                    <div class="flex items-center gap-1.5 bg-white p-1.5 rounded-2xl border border-slate-200 shadow-sm overflow-x-auto max-w-full">
                        <button onclick="filterPhase('ALL')" id="filter-btn-ALL" class="phase-filter-btn px-4 py-2 rounded-xl text-xs font-bold transition-all bg-brand-red text-white shadow">
                            Semua Fase
                        </button>
                        <button onclick="filterPhase('FASE_A')" id="filter-btn-FASE_A" class="phase-filter-btn px-4 py-2 rounded-xl text-xs font-bold transition-all text-slate-600 hover:bg-slate-100">
                            Fase A (Kelas 1-2)
                        </button>
                        <button onclick="filterPhase('FASE_B')" id="filter-btn-FASE_B" class="phase-filter-btn px-4 py-2 rounded-xl text-xs font-bold transition-all text-slate-600 hover:bg-slate-100">
                            Fase B (Kelas 3-4)
                        </button>
                        <button onclick="filterPhase('FASE_C')" id="filter-btn-FASE_C" class="phase-filter-btn px-4 py-2 rounded-xl text-xs font-bold transition-all text-slate-600 hover:bg-slate-100">
                            Fase C (Kelas 5-6)
                        </button>
                    </div>
                </div>

                <!-- Comic Grid Catalog -->
                <div id="comic-grid-siswa" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                    <!-- Dynamic Comics Inserted via JS -->
                </div>

                <!-- Empty State Message -->
                <div id="empty-siswa-comics" class="hidden text-center py-16 bg-white rounded-3xl border-2 border-dashed border-slate-200 p-8">
                    <i data-lucide="book-open" class="w-16 h-16 text-slate-300 mx-auto mb-3"></i>
                    <h4 class="text-lg font-bold text-slate-700 font-fredoka">Belum Ada Komik Di Fase Ini</h4>
                    <p class="text-sm text-slate-500 max-w-md mx-auto mt-1">Bapak/Ibu Guru akan segera mengunggah karya komik karakter menarik untuk fase ini!</p>
                </div>

            </section>

            <!-- TAB CONTENT: GURU PORTAL -->
            <section id="tab-guru" class="tab-content morph-element hidden">
                
                <!-- Guru Header Summary -->
                <div class="mb-8">
                    <h2 class="text-2xl font-bold font-fredoka text-slate-900 flex items-center gap-2">
                        <i data-lucide="layout-dashboard" class="w-7 h-7 text-brand-red"></i> Dashboard Pengelolaan Komik Digital
                    </h2>
                    <p class="text-xs sm:text-sm text-slate-600">Unggah komik pelajaran karakter baru, atur rekapitulasi, dan kelola karya komik siswa.</p>
                </div>

                <!-- Guru Statistics Cards -->
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
                    <div class="bg-gradient-to-br from-red-500 to-rose-600 p-5 rounded-2xl text-white shadow-lg flex items-center justify-between">
                        <div>
                            <p class="text-xs text-rose-100 font-medium">Total Komik Terunggah</p>
                            <h3 id="stat-total-komik" class="text-3xl font-fredoka font-bold mt-1">0</h3>
                        </div>
                        <div class="p-3 bg-white/20 backdrop-blur rounded-xl">
                            <i data-lucide="book-marked" class="w-7 h-7"></i>
                        </div>
                    </div>

                    <div class="bg-gradient-to-br from-blue-500 to-indigo-600 p-5 rounded-2xl text-white shadow-lg flex items-center justify-between">
                        <div>
                            <p class="text-xs text-blue-100 font-medium">Komik Fase A (Kelas 1-2)</p>
                            <h3 id="stat-fase-a" class="text-3xl font-fredoka font-bold mt-1">0</h3>
                        </div>
                        <div class="p-3 bg-white/20 backdrop-blur rounded-xl">
                            <i data-lucide="shapes" class="w-7 h-7"></i>
                        </div>
                    </div>

                    <div class="bg-gradient-to-br from-amber-500 to-orange-600 p-5 rounded-2xl text-white shadow-lg flex items-center justify-between">
                        <div>
                            <p class="text-xs text-amber-100 font-medium">Komik Fase B (Kelas 3-4)</p>
                            <h3 id="stat-fase-b" class="text-3xl font-fredoka font-bold mt-1">0</h3>
                        </div>
                        <div class="p-3 bg-white/20 backdrop-blur rounded-xl">
                            <i data-lucide="sparkles" class="w-7 h-7"></i>
                        </div>
                    </div>

                    <div class="bg-gradient-to-br from-emerald-500 to-teal-600 p-5 rounded-2xl text-white shadow-lg flex items-center justify-between">
                        <div>
                            <p class="text-xs text-emerald-100 font-medium">Komik Fase C (Kelas 5-6)</p>
                            <h3 id="stat-fase-c" class="text-3xl font-fredoka font-bold mt-1">0</h3>
                        </div>
                        <div class="p-3 bg-white/20 backdrop-blur rounded-xl">
                            <i data-lucide="award" class="w-7 h-7"></i>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
                    
                    <!-- FORM UNGGAH KOMIK BARU (7 COLS) -->
                    <div class="lg:col-span-7 bg-white rounded-3xl p-6 sm:p-8 shadow-md border border-slate-200">
                        <div class="flex items-center gap-3 pb-4 mb-6 border-b border-slate-100">
                            <div class="p-3 bg-red-100 text-brand-red rounded-2xl">
                                <i data-lucide="upload-cloud" class="w-6 h-6"></i>
                            </div>
                            <div>
                                <h3 class="text-lg font-bold font-fredoka text-slate-800">Formulir Publikasi Komik Baru</h3>
                                <p class="text-xs text-slate-500">Isi detail komik dan upload gambar dari perangkat</p>
                            </div>
                        </div>

                        <form id="upload-comic-form" onsubmit="handleComicUpload(event)" class="space-y-5">
                            <div>
                                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Judul Komik Karakter *</label>
                                <input type="text" id="comic-title" placeholder="Contoh: Petualangan Budi Belajar Kejujuran" required class="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 text-sm text-slate-800 focus:ring-2 focus:ring-brand-red focus:bg-white outline-none transition">
                            </div>

                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Target Fase / Kelas *</label>
                                    <select id="comic-phase" required class="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 text-sm text-slate-800 focus:ring-2 focus:ring-brand-red focus:bg-white outline-none transition font-medium">
                                        <option value="FASE_A">Fase A (Kelas 1-2)</option>
                                        <option value="FASE_B">Fase B (Kelas 3-4)</option>
                                        <option value="FASE_C">Fase C (Kelas 5-6)</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Pengarang / Kreator *</label>
                                    <input type="text" id="comic-author" placeholder="Nama Guru / Penyusun" required class="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 text-sm text-slate-800 focus:ring-2 focus:ring-brand-red focus:bg-white outline-none transition">
                                </div>
                            </div>

                            <div>
                                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Nilai Karakter Pancasila *</label>
                                <textarea id="comic-description" rows="2" placeholder="Jelaskan nilai karakter yang diajarkan (Contoh: Gotong Royong & Saling Menghargai)" required class="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 text-sm text-slate-800 focus:ring-2 focus:ring-brand-red focus:bg-white outline-none transition"></textarea>
                            </div>

                            <!-- Multiple File Upload -->
                            <div>
                                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
                                    Unggah Berkas Halaman Komik (JPG/PNG) *
                                </label>
                                <div class="border-2 border-dashed border-slate-300 hover:border-brand-red rounded-2xl p-6 text-center bg-slate-50 hover:bg-red-50/50 transition cursor-pointer relative" onclick="document.getElementById('comic-files').click()">
                                    <input type="file" id="comic-files" accept="image/png, image/jpeg, image/jpg" multiple onchange="handleFilePreview(event)" class="hidden">
                                    <i data-lucide="image-plus" class="w-10 h-10 text-brand-red mx-auto mb-2"></i>
                                    <p class="text-xs font-bold text-slate-700">Klik untuk memilih beberapa gambar sekaligus</p>
