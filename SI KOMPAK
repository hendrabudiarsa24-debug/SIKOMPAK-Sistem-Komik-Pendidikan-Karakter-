            {
                id: 'dummy-2',
                title: 'Gotong Royong Membersihkan Kelas',
                phase: 'FASE_B',
                author: 'Bapak Ahmad, S.Pd',
                description: 'Siti dan teman-teman bekerjasama merapikan pojok baca kelas 4.',
                pages: [
                    generateSampleSVG('Gotong Royong Kelas', 'Fase B (Kelas 3-4)', 1, ['#1E88E5', '#26C6DA']),
                    generateSampleSVG('Membagi Tugas Bersama', 'Kerjasama Tim', 2, ['#1E88E5', '#26C6DA']),
                    generateSampleSVG('Kelas Menjadi Indah', 'Indahnya Kebersamaan', 3, ['#1E88E5', '#26C6DA'])
                ],
                createdAt: new Date().toISOString()
            },
            {
                id: 'dummy-3',
                title: 'Kreatif & Bernalar Kritis',
                phase: 'FASE_C',
                author: 'Tim Guru SDN Pilang 1',
                description: 'Memanfaat barang bekas menjadi media tanam hidroponik sekolah.',
                pages: [
                    generateSampleSVG('Inovasi Plastik Bekas', 'Fase C (Kelas 5-6)', 1, ['#43A047', '#66BB6A']),
                    generateSampleSVG('Diskusi Rancangan', 'Bernalar Kritis', 2, ['#43A047', '#66BB6A'])
                ],
                createdAt: new Date().toISOString()
            }
        ];

        window.onload = function() {
            lucide.createIcons();
            loadComicsFromStorage();
            loadReflectionsFromStorage();
        };

        // Load & Save Comics
        function loadComicsFromStorage() {
            const saved = localStorage.getItem(STORAGE_KEY_COMICS);
            if (saved) {
                try {
                    currentComicList = JSON.parse(saved);
                } catch (e) {
                    currentComicList = defaultDummyComics;
                }
            } else {
                currentComicList = defaultDummyComics;
                saveComicsToStorage();
            }
        }

        function saveComicsToStorage() {
            localStorage.setItem(STORAGE_KEY_COMICS, JSON.stringify(currentComicList));
        }

        /* LOGIN & ROLE MANAGEMENT LOGIC */
        function togglePasswordVisibility(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            if (input.type === 'password') {
                input.type = 'text';
                icon.setAttribute('data-lucide', 'eye-off');
            } else {
                input.type = 'password';
                icon.setAttribute('data-lucide', 'eye');
            }
            lucide.createIcons();
        }

        function handleGuruLogin(e) {
            e.preventDefault();
            const pass = document.getElementById('guru-password').value;
            if (pass === 'Pilang1') {
                loginAsRole('GURU');
                showToast('Selamat datang, Guru SD Negeri Pilang 1!', 'success');
            } else {
                showToast('Password sandi Guru salah! Silakan coba lagi.', 'error');
            }
        }

        function loginAsRole(role) {
            currentRole = role;
            document.getElementById('login-page').classList.add('hidden');
            const mainApp = document.getElementById('main-app');
            mainApp.classList.remove('hidden');
            mainApp.classList.add('flex');

            // Render Nav Tabs & Active View
            renderTabNav();
            switchTab(role.toLowerCase());

            // Update Header Status Badge
            const badge = document.getElementById('role-badge');
            const userDisplay = document.getElementById('user-display-name');

            if (role === 'GURU') {
                badge.textContent = 'GURU / ADMIN';
                badge.className = 'text-[10px] font-bold px-2.5 py-0.5 rounded-full bg-yellow-400 text-red-950 uppercase tracking-wider';
                userDisplay.textContent = 'Bapak/Ibu Guru (SDN PILANG 1)';
            } else if (role === 'SISWA') {
                badge.textContent = 'SISWA';
                badge.className = 'text-[10px] font-bold px-2.5 py-0.5 rounded-full bg-emerald-400 text-emerald-950 uppercase tracking-wider';
                userDisplay.textContent = 'Siswa SD Negeri Pilang 1';
            } else {
                badge.textContent = 'ORANG TUA';
                badge.className = 'text-[10px] font-bold px-2.5 py-0.5 rounded-full bg-blue-300 text-blue-950 uppercase tracking-wider';
                userDisplay.textContent = 'Orang Tua / Wali Murid';
            }

            // Trigger confetti for student entrance
            if (role === 'SISWA' && typeof confetti === 'function') {
                confetti({ particleCount: 50, spread: 60, origin: { y: 0.8 } });
            }
        }

        function logout() {
            currentRole = null;
            document.getElementById('main-app').classList.add('hidden');
            document.getElementById('main-app').classList.remove('flex');
            document.getElementById('login-page').classList.remove('hidden');
            document.getElementById('guru-password').value = '';
            showToast('Anda telah keluar dari aplikasi.', 'info');
        }

        function renderTabNav() {
            const desktopNav = document.getElementById('desktop-tab-nav');
            const mobileNav = document.getElementById('mobile-tab-nav');

            const tabs = [
                { id: 'siswa', label: 'Portal Siswa', icon: 'smile', roles: ['GURU', 'SISWA', 'ORTU'] },
                { id: 'guru', label: 'Portal Guru', icon: 'user-cog', roles: ['GURU'] },
                { id: 'ortu', label: 'Portal Orang Tua', icon: 'heart-handshake', roles: ['GURU', 'ORTU'] }
            ];

            let desktopHTML = '';
            let mobileHTML = '';

            tabs.forEach(tab => {
                if (tab.roles.includes(currentRole)) {
                    desktopHTML += `
                        <button onclick="switchTab('${tab.id}')" id="tab-btn-desktop-${tab.id}" class="tab-btn-desktop px-4 py-2 rounded-xl text-xs font-bold transition flex items-center gap-2 text-white/80 hover:text-white hover:bg-white/10">
                            <i data-lucide="${tab.icon}" class="w-4 h-4"></i>
                            <span>${tab.label}</span>
                        </button>
                    `;
                    mobileHTML += `
                        <button onclick="switchTab('${tab.id}')" id="tab-btn-mobile-${tab.id}" class="tab-btn-mobile px-3 py-1.5 rounded-xl text-xs font-bold transition flex items-center gap-1.5 text-white/80 whitespace-nowrap">
                            <i data-lucide="${tab.icon}" class="w-3.5 h-3.5"></i>
                            <span>${tab.label}</span>
                        </button>
                    `;
                }
            });

            desktopNav.innerHTML = desktopHTML;
            mobileNav.innerHTML = mobileHTML;
            lucide.createIcons();
        }

        function switchTab(tabId) {
            // Hide all tab sections
            document.querySelectorAll('.tab-content').forEach(el => {
                el.classList.add('hidden');
            });

            // Show selected tab
            const activeSection = document.getElementById(`tab-${tabId}`);
            if (activeSection) {
                activeSection.classList.remove('hidden');
                activeSection.classList.add('fade-in-scale');
            }

            // Update tab button styles
            document.querySelectorAll('.tab-btn-desktop, .tab-btn-mobile').forEach(btn => {
                btn.classList.remove('bg-white', 'text-brand-red', 'shadow');
                btn.classList.add('text-white/80');
            });

            const activeDesktopBtn = document.getElementById(`tab-btn-desktop-${tabId}`);
            const activeMobileBtn = document.getElementById(`tab-btn-mobile-${tabId}`);

            if (activeDesktopBtn) {
                activeDesktopBtn.classList.add('bg-white', 'text-brand-red', 'shadow');
                activeDesktopBtn.classList.remove('text-white/80');
            }
            if (activeMobileBtn) {
                activeMobileBtn.classList.add('bg-white', 'text-brand-red', 'shadow');
                activeMobileBtn.classList.remove('text-white/80');
            }

            // Refresh tab views
            if (tabId === 'siswa') renderSiswaCatalog();
            if (tabId === 'guru') renderGuruDashboard();
            if (tabId === 'ortu') renderOrtuDashboard();
        }

        function handleFilePreview(event) {
            const files = Array.from(event.target.files);
            if (!files || files.length === 0) return;

            uploadedFilesBase64 = [];
            const container = document.getElementById('preview-area-container');
            const grid = document.getElementById('preview-thumbnails-grid');
            const countLabel = document.getElementById('preview-count');

            grid.innerHTML = '';
            container.classList.remove('hidden');
            countLabel.textContent = files.length;

            let loadedCount = 0;

            files.forEach((file, index) => {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const base64 = e.target.result;
                    uploadedFilesBase64[index] = base64;

                    const thumbDiv = document.createElement('div');
                    thumbDiv.className = `relative rounded-xl overflow-hidden border-2 shadow-sm ${index === 0 ? 'border-brand-red ring-2 ring-red-200' : 'border-slate-200'}`;
                    thumbDiv.innerHTML = `
                        <img src="${base64}" class="w-full h-24 object-cover">
                        <span class="absolute bottom-1 left-1 bg-black/70 text-white text-[10px] font-bold px-1.5 py-0.5 rounded">Hlm ${index + 1}</span>
                        ${index === 0 ? '<span class="absolute top-1 right-1 bg-brand-red text-white text-[9px] font-bold px-1 rounded">Sampul</span>' : ''}
                    `;
                    grid.appendChild(thumbDiv);
                };
                reader.readAsDataURL(file);
            });
        }

        function handleComicUpload(e) {
            e.preventDefault();
            if (uploadedFilesBase64.length === 0) {
                showToast('Pilih setidaknya 1 gambar halaman komik!', 'error');
                return;
            }

            const title = document.getElementById('comic-title').value.trim();
            const phase = document.getElementById('comic-phase').value;
            const author = document.getElementById('comic-author').value.trim();
            const description = document.getElementById('comic-description').value.trim();

            const newComic = {
                id: 'comic-' + Date.now(),
                title: title,
                phase: phase,
                author: author,
                description: description,
                pages: [...uploadedFilesBase64],
                createdAt: new Date().toISOString()
            };

            currentComicList.unshift(newComic);
            saveComicsToStorage();

            // Reset form
            document.getElementById('upload-comic-form').reset();
            document.getElementById('preview-area-container').classList.add('hidden');
            uploadedFilesBase64 = [];

            showToast('Komik berhasil diterbitkan!', 'success');
            renderGuruDashboard();
        }

        function deleteComic(comicId) {
            if (confirm('Apakah Anda yakin ingin menghapus komik ini?')) {
                currentComicList = currentComicList.filter(c => c.id !== comicId);
                saveComicsToStorage();
                renderGuruDashboard();
                showToast('Komik telah dihapus.', 'info');
            }
        }

        function renderGuruDashboard() {
            // Update stats
            document.getElementById('stat-total-komik').textContent = currentComicList.length;
            document.getElementById('stat-fase-a').textContent = currentComicList.filter(c => c.phase === 'FASE_A').length;
            document.getElementById('stat-fase-b').textContent = currentComicList.filter(c => c.phase === 'FASE_B').length;
            document.getElementById('stat-fase-c').textContent = currentComicList.filter(c => c.phase === 'FASE_C').length;

            document.getElementById('rekap-count').textContent = currentComicList.length;

            const listContainer = document.getElementById('guru-comics-list');
            if (currentComicList.length === 0) {
                listContainer.innerHTML = `<p class="text-xs text-slate-400 text-center py-6">Belum ada komik yang diunggah.</p>`;
                return;
            }

            let html = '';
            currentComicList.forEach(c => {
                const phaseLabel = c.phase === 'FASE_A' ? 'Fase A' : c.phase === 'FASE_B' ? 'Fase B' : 'Fase C';
                const phaseBg = c.phase === 'FASE_A' ? 'bg-red-100 text-red-700' : c.phase === 'FASE_B' ? 'bg-amber-100 text-amber-700' : 'bg-emerald-100 text-emerald-700';

                html += `
                    <div class="bg-slate-50 p-3 rounded-2xl border border-slate-200 flex items-center justify-between gap-3 hover:bg-slate-100/80 transition">
                        <div class="flex items-center gap-3 overflow-hidden">
                            <img src="${c.pages[0]}" class="w-12 h-14 object-cover rounded-lg border border-slate-300 flex-shrink-0">
                            <div class="min-w-0">
                                <span class="text-[10px] font-bold px-2 py-0.5 rounded-full ${phaseBg}">${phaseLabel}</span>
                                <h4 class="text-xs font-bold text-slate-800 truncate mt-0.5">${c.title}</h4>
                                <p class="text-[11px] text-slate-500">${c.pages.length} Halaman • Oleh: ${c.author}</p>
                            </div>
                        </div>

                        <div class="flex items-center gap-1.5 flex-shrink-0">
                            <button onclick="openComicReader('${c.id}')" title="Preview Komik" class="p-2 bg-blue-100 text-blue-600 hover:bg-blue-200 rounded-xl transition">
                                <i data-lucide="eye" class="w-4 h-4"></i>
                            </button>
                            <button onclick="deleteComic('${c.id}')" title="Hapus Komik" class="p-2 bg-red-100 text-red-600 hover:bg-red-200 rounded-xl transition">
                                <i data-lucide="trash-2" class="w-4 h-4"></i>
                            </button>
                        </div>
                    </div>
                `;
            });

            listContainer.innerHTML = html;
            lucide.createIcons();
        }

        function filterPhase(phase) {
            currentActivePhase = phase;

            document.querySelectorAll('.phase-filter-btn').forEach(btn => {
                btn.className = 'phase-filter-btn px-4 py-2 rounded-xl text-xs font-bold transition-all text-slate-600 hover:bg-slate-100';
            });

            const activeBtn = document.getElementById(`filter-btn-${phase}`);
            if (activeBtn) {
                activeBtn.className = 'phase-filter-btn px-4 py-2 rounded-xl text-xs font-bold transition-all bg-brand-red text-white shadow';
            }

            renderSiswaCatalog();
        }

        function renderSiswaCatalog() {
            const grid = document.getElementById('comic-grid-siswa');
            const emptyMsg = document.getElementById('empty-siswa-comics');

            let filtered = currentComicList;
            if (currentActivePhase !== 'ALL') {
                filtered = currentComicList.filter(c => c.phase === currentActivePhase);
            }

            if (filtered.length === 0) {
                grid.innerHTML = '';
                emptyMsg.classList.remove('hidden');
                return;
            }

            emptyMsg.classList.add('hidden');
            let html = '';

            filtered.forEach(c => {
                const phaseLabel = c.phase === 'FASE_A' ? 'Fase A (Kelas 1-2)' : c.phase === 'FASE_B' ? 'Fase B (Kelas 3-4)' : 'Fase C (Kelas 5-6)';
                const phaseBadgeBg = c.phase === 'FASE_A' ? 'bg-red-500' : c.phase === 'FASE_B' ? 'bg-amber-500' : 'bg-emerald-600';

                html += `
                    <div onclick="openComicReader('${c.id}')" class="bg-white rounded-3xl overflow-hidden border border-slate-200/80 shadow-md hover:shadow-2xl transition-all duration-300 hover:-translate-y-1.5 cursor-pointer flex flex-col group">
                        
                        <!-- Thumbnail Cover -->
                        <div class="relative h-56 w-full bg-slate-100 overflow-hidden">
                            <img src="${c.pages[0]}" alt="${c.title}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                            <span class="absolute top-3 left-3 text-[10px] font-bold px-3 py-1 rounded-full text-white shadow ${phaseBadgeBg}">
                                ${phaseLabel}
                            </span>
                            <span class="absolute bottom-3 right-3 bg-black/70 backdrop-blur text-white text-[10px] font-bold px-2.5 py-1 rounded-full flex items-center gap-1">
                                <i data-lucide="layers" class="w-3 h-3"></i> ${c.pages.length} Halaman
                            </span>
                        </div>

                        <!-- Content Details -->
                        <div class="p-5 flex-1 flex flex-col justify-between space-y-3">
                            <div>
                                <h3 class="font-fredoka text-base font-bold text-slate-900 group-hover:text-brand-red transition-colors line-clamp-2">
                                    ${c.title}
                                </h3>
                                <p class="text-xs text-slate-500 mt-1 line-clamp-2">
                                    ${c.description}
                                </p>
                            </div>

                            <div class="pt-2 border-t border-slate-100 flex items-center justify-between text-xs text-slate-400 font-medium">
                                <span>Oleh: <strong class="text-slate-600">${c.author}</strong></span>
                                <span class="text-brand-red font-bold group-hover:translate-x-1 transition-transform inline-flex items-center gap-0.5">
                                    Baca <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
                                </span>
                            </div>
                        </div>

                    </div>
                `;
            });

            grid.innerHTML = html;
            lucide.createIcons();
        }

        function openComicReader(comicId) {
            activeReaderComic = currentComicList.find(c => c.id === comicId);
            if (!activeReaderComic) return;

            activeReaderPageIndex = 0;
            activeReaderMode = 'SLIDE';

            document.getElementById('modal-comic-title').textContent = activeReaderComic.title;
            document.getElementById('modal-comic-author').textContent = `Oleh: ${activeReaderComic.author}`;

            document.getElementById('comic-reader-modal').classList.remove('hidden');
            document.getElementById('comic-reader-modal').classList.add('flex');

            setReaderMode('SLIDE');
        }

        function closeComicReader() {
            document.getElementById('comic-reader-modal').classList.add('hidden');
            document.getElementById('comic-reader-modal').classList.remove('flex');
            activeReaderComic = null;
        }

        function setReaderMode(mode) {
            activeReaderMode = mode;
            const btnSlide = document.getElementById('btn-mode-slide');
            const btnScroll = document.getElementById('btn-mode-scroll');

            const slideView = document.getElementById('reader-view-slide');
            const scrollView = document.getElementById('reader-view-scroll');

            if (mode === 'SLIDE') {
                btnSlide.className = 'px-3 py-1.5 rounded-lg text-xs font-bold transition flex items-center gap-1.5 bg-brand-red text-white';
                btnScroll.className = 'px-3 py-1.5 rounded-lg text-xs font-bold transition flex items-center gap-1.5 text-slate-400 hover:text-white';

                slideView.classList.remove('hidden');
                slideView.classList.add('flex');
                scrollView.classList.add('hidden');

                updateSlideView();
            } else {
                btnScroll.className = 'px-3 py-1.5 rounded-lg text-xs font-bold transition flex items-center gap-1.5 bg-brand-red text-white';
                btnSlide.className = 'px-3 py-1.5 rounded-lg text-xs font-bold transition flex items-center gap-1.5 text-slate-400 hover:text-white';

                slideView.classList.add('hidden');
                slideView.classList.remove('flex');
                scrollView.classList.remove('hidden');

                renderScrollView();
            }
        }

        function updateSlideView() {
            if (!activeReaderComic) return;

            const imgDisplay = document.getElementById('slide-image-display');
            const counter = document.getElementById('slide-page-counter');
            const btnPrev = document.getElementById('btn-prev-page');
            const btnNext = document.getElementById('btn-next-page');

            imgDisplay.src = activeReaderComic.pages[activeReaderPageIndex];
            counter.textContent = `Halaman ${activeReaderPageIndex + 1} / ${activeReaderComic.pages.length}`;

            btnPrev.disabled = activeReaderPageIndex === 0;
            btnNext.disabled = activeReaderPageIndex === activeReaderComic.pages.length - 1;
        }

        function prevSlide() {
            if (activeReaderPageIndex > 0) {
                activeReaderPageIndex--;
                updateSlideView();
            }
        }

        function nextSlide() {
            if (activeReaderComic && activeReaderPageIndex < activeReaderComic.pages.length - 1) {
                activeReaderPageIndex++;
                updateSlideView();
            }
        }

        function renderScrollView() {
            if (!activeReaderComic) return;
            const container = document.getElementById('scroll-images-container');

            let html = '';
            activeReaderComic.pages.forEach((pageSrc, idx) => {
                html += `
                    <div class="relative w-full bg-slate-900 rounded-xl overflow-hidden shadow-xl border border-slate-800">
                        <img src="${pageSrc}" class="w-full h-auto object-contain">
                        <span class="absolute top-2 right-2 bg-black/70 text-white text-[10px] font-bold px-2 py-0.5 rounded-full">Halaman ${idx + 1}</span>
                    </div>
                `;
            });

            container.innerHTML = html;
        }

        function handleReflectionSubmit(e) {
            e.preventDefault();
            const childName = document.getElementById('child-name').value.trim();
            const childClass = document.getElementById('child-class').value.trim();
            const pancasilaVal = document.getElementById('child-pancasila-val').value;
            const notes = document.getElementById('child-notes').value.trim();

            const reflection = {
                id: 'ref-' + Date.now(),
                childName,
                childClass,
                pancasilaVal,
                notes,
                date: new Date().toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })
            };

            const saved = getReflections();
            saved.unshift(reflection);
            localStorage.setItem(STORAGE_KEY_REFLECTIONS, JSON.stringify(saved));

            document.getElementById('ortu-reflection-form').reset();
            showToast('Catatan refleksi berhasil disimpan!', 'success');
            renderOrtuDashboard();
        }

        function getReflections() {
            const saved = localStorage.getItem(STORAGE_KEY_REFLECTIONS);
            return saved ? JSON.parse(saved) : [];
        }

        function renderOrtuDashboard() {
            const reflections = getReflections();
            const container = document.getElementById('reflection-history-list');

            if (reflections.length === 0) {
                container.innerHTML = `<p class="text-xs text-slate-400 text-center py-4">Belum ada riwayat refleksi tersimpan.</p>`;
                return;
            }

            let html = '';
            reflections.forEach(r => {
                html += `
                    <div class="bg-slate-50 p-3.5 rounded-2xl border border-slate-200">
                        <div class="flex items-center justify-between mb-1">
                            <strong class="text-xs font-bold text-slate-800">${r.childName} (${r.childClass})</strong>
                            <span class="text-[10px] text-slate-400">${r.date}</span>
                        </div>
                        <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 inline-block mb-1.5">
                            ${r.pancasilaVal}
                        </span>
                        <p class="text-xs text-slate-600 italic">"${r.notes}"</p>
                    </div>
                `;
            });

            container.innerHTML = html;
        }

        function loadReflectionsFromStorage() {
            renderOrtuDashboard();
        }

        function showToast(message, type = 'info') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');

            const bgClass = type === 'success' ? 'bg-emerald-600' : type === 'error' ? 'bg-brand-red' : 'bg-slate-800';
            const iconName = type === 'success' ? 'check-circle' : type === 'error' ? 'alert-circle' : 'info';

            toast.className = `${bgClass} text-white text-xs font-semibold px-4 py-3 rounded-2xl shadow-xl flex items-center gap-2 pointer-events-auto fade-in-scale border border-white/20`;
            toast.innerHTML = `<i data-lucide="${iconName}" class="w-4 h-4"></i><span>${message}</span>`;

            container.appendChild(toast);
            lucide.createIcons();

            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateY(-10px)';
                toast.style.transition = 'all 0.3s ease';
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }
    </script>
</body>
</html>
