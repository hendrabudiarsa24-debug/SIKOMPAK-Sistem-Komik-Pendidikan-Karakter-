                <text x="300" y="555" text-anchor="middle" fill="#64748B" font-family="Arial, sans-serif" font-size="16">${subtitle}</text>

                <!-- Footer Comic Dialog Box -->
                <rect x="80" y="640" width="440" height="120" fill="#FFF9C4" rx="16" stroke="#FBC02D" stroke-width="3"/>
                <text x="300" y="685" text-anchor="middle" fill="#5D4037" font-family="Arial, sans-serif" font-size="18" font-weight="bold">Halaman ${pageNum}</text>
                <text x="300" y="720" text-anchor="middle" fill="#795548" font-family="Arial, sans-serif" font-size="15">"Mari selalu menerapkan nilai kebaikan dalam tindakan nyata!"</text>
            </svg>`;
            return 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svgString);
        }

        const defaultDummyComics = [
            {
                id: 'dummy-1',
                title: 'Petualangan Budi & Kejujuran',
                phase: 'FASE_A',
                author: 'Ibu Ani, S.Pd',
                description: 'Belajar berkata jujur saat menemukan dompet terjatuh di halaman sekolah.',
                pages: [
                    generateSampleSVG('Petualangan Budi & Kejujuran', 'Fase A (Kelas 1-2)', 1, ['#E53935', '#FF7043']),
                    generateSampleSVG('Budi Menemukan Dompet', 'Halaman Cerita Pertama', 2, ['#E53935', '#FF7043']),
                    generateSampleSVG('Mengembalikan Kepada Guru', 'Nilai Kejujuran Pancasila', 3, ['#E53935', '#FF7043'])
